<!--
  Nhập số: enter the customer + numbers (+ optional "Điểm vào") side of a
  data entry. "Điểm ra" (result) is intentionally NOT editable here anymore
  - it moved to ResultsView.vue ("Nhập kết quả") since the two are a
  two-step daily workflow (enter bets in the morning, enter results after
  the lottery draw) that used to be crammed into one form.

  API: GET/POST /me/entries, PATCH /me/entries/:id (no DELETE endpoint
  exists on the backend for entries - see note below).
-->
<script setup>
import { showConfirm } from '../confirm'
import AppDatePicker from '../components/AppDatePicker.vue'
import AppSelect from '../components/AppSelect.vue'
import AppIcon from '../components/AppIcon.vue'
import { computed, onMounted, reactive, ref, watch } from 'vue'
import { api } from '../api'
import { useAuthStore } from '../stores/auth'
import { betTypeLabel } from '../betTypes'

const auth = useAuthStore()

const entries = ref([])
const loading = ref(true)
const loadError = ref('')

// Customer roster (Khách hàng page) - entry form must PICK a customer from
// here rather than free-typing a name, so a typo can't silently create a
// "phantom" duplicate customer. See CustomersView.vue for add/remove.
const customers = ref([])
async function loadCustomers() {
  try {
    const { customers: list } = await api.get('/me/customers')
    customers.value = list
  } catch (_) {
    // Leave the list empty - the select will just show none.
  }
}

// Bet types (đề/lô/...) come from this account's own rate config - see
// /scoring-settings (also used by ScoringView to pick a payout rate).
// Falls back to {de, lo} if that call fails, so the form still works.
const betTypes = ref(['de', 'lo'])
async function loadBetTypes() {
  try {
    const { rates } = await api.get('/me/scoring-settings')
    const keys = Object.keys(rates || {})
    if (keys.length) betTypes.value = keys
  } catch (_) {
    // Keep the fallback list.
  }
}

const today = () => new Date().toISOString().slice(0, 10)

const form = reactive({
  customerName: '',
  entryDate: today(),
  note: '',
})
// Per bet type, a LIST of (số, điểm vào) rows - each number can carry its
// own stake, since in practice a customer rarely puts the same amount on
// every number. Each filled-in row becomes its own data_entries row on
// submit (value=<số>, score=<điểm> that row's own). Keyed dynamically by
// whatever /me/scoring-settings currently has, so adding a type in Cấu
// hình tính điểm adds its own block here automatically.
function blankRow() {
  return { value: '', score: '' }
}
const typeInputs = reactive({})
function ensureTypeInputs(types) {
  for (const t of types) {
    if (!(t in typeInputs)) typeInputs[t] = { rows: [blankRow()] }
  }
  for (const key of Object.keys(typeInputs)) {
    if (!types.includes(key)) delete typeInputs[key]
  }
}
watch(betTypes, (types) => ensureTypeInputs(types), { immediate: true })

function addRow(type) {
  typeInputs[type].rows.push(blankRow())
}
function removeRow(type, idx) {
  typeInputs[type].rows.splice(idx, 1)
  if (typeInputs[type].rows.length === 0) typeInputs[type].rows.push(blankRow())
}

const submitting = ref(false)
const formError = ref('')

const editingId = ref(null)
const editForm = reactive({
  customerName: '',
  value: '',
  entryDate: '',
  score: '',
  betType: 'de',
  note: '',
})
const editError = ref('')
const editSubmitting = ref(false)

// OCR (đọc số liệu từ ảnh): runs fully client-side via tesseract.js, no
// image ever leaves the browser. It only ever *suggests* values into the
// form - never auto-submits - since handwriting/photo OCR on freeform
// betting numbers is inherently unreliable and a silent mistake here means
// real money. The user must review/edit and press "Thêm số liệu" themselves.
const ocrRunning = ref(false)
const ocrProgress = ref(0)
const ocrError = ref('')
const ocrRawText = ref('')
const ocrPreviewUrl = ref('')
const ocrFileInput = ref(null)

function pickImage() {
  ocrFileInput.value?.click()
}

async function onImageSelected(e) {
  const file = e.target.files?.[0]
  e.target.value = '' // allow picking the same file again later
  if (!file) return

  ocrError.value = ''
  ocrRawText.value = ''
  if (ocrPreviewUrl.value) URL.revokeObjectURL(ocrPreviewUrl.value)
  ocrPreviewUrl.value = URL.createObjectURL(file)

  ocrRunning.value = true
  ocrProgress.value = 0
  try {
    const { createWorker } = await import('tesseract.js')
    const worker = await createWorker('vie', 1, {
      logger: (m) => {
        if (m.status === 'recognizing text') ocrProgress.value = Math.round((m.progress || 0) * 100)
      },
    })
    try {
      const { data } = await worker.recognize(file)
      ocrRawText.value = (data.text || '').trim()
      applyOcrGuess(ocrRawText.value)
    } finally {
      await worker.terminate()
    }
  } catch (err) {
    ocrError.value = 'Không đọc được ảnh (có thể do mạng chậm khi tải mô hình OCR lần đầu). Bạn có thể nhập tay.'
  } finally {
    ocrRunning.value = false
  }
}

function applyOcrGuess(text) {
  if (!text) return
  const lines = text
    .split('\n')
    .map((l) => l.trim())
    .filter(Boolean)

  // Numbers: lottery-style groups of 2-4 digits, one row per number since
  // each one may carry its own "Điểm vào". OCR can't tell which bet type a
  // photo is for, so this fills the first still-empty type block (usually
  // "Đề") - leaving the rest for the user to fill or move manually. Điểm
  // vào is left blank on every row - OCR only guesses the numbers.
  const numberGroups = text.match(/\d{2,4}/g) || []
  if (numberGroups.length) {
    const target = betTypes.value.find((t) => typeInputs[t]?.rows.every((r) => !r.value.trim()))
    if (target) typeInputs[target].rows = numberGroups.map((n) => ({ value: n, score: '' }))
  }

  // First line that has letters (not just digits/punctuation) is the best
  // guess for a customer name written above/near the numbers. Since the
  // name field is now a picklist (not free text), only auto-select it when
  // it EXACTLY matches (case-insensitive) an existing roster entry -
  // otherwise leave it alone rather than guess-creating a name that isn't
  // in the roster and can't display in the <select>.
  const nameLine = lines.find((l) => /[a-zA-ZÀ-ỹ]{2,}/.test(l))
  if (nameLine && !form.customerName.trim()) {
    const match = customers.value.find((c) => c.name.toLowerCase() === nameLine.toLowerCase())
    if (match) form.customerName = match.name
  }
}

function clearOcr() {
  if (ocrPreviewUrl.value) URL.revokeObjectURL(ocrPreviewUrl.value)
  ocrPreviewUrl.value = ''
  ocrRawText.value = ''
  ocrError.value = ''
}

const pkg = computed(() => auth.user?.package)
const stats = computed(() => auth.user?.stats)
const canAdd = computed(() => pkg.value?.isActive)

// "Điểm vào" (score) / "Điểm ra" (result) reuse the two existing free-text
// entry fields as numeric point counters instead of generic notes - parsed
// leniently (strip everything but digits/minus/dot) so entries typed before
// this change don't break the totals, they just count as 0.
function toNumber(str) {
  if (!str) return 0
  const cleaned = String(str).replace(/[^\d.-]/g, '')
  const n = parseFloat(cleaned)
  return Number.isFinite(n) ? n : 0
}

// The list/stats below only ever show the customer currently selected in
// the form above - this page is a per-customer data-entry workspace, not
// a full history browser (that's Khách hàng/Tính điểm). No customer
// selected yet -> nothing to show.
const visibleEntries = computed(() => {
  if (!form.customerName) return []
  return entries.value.filter((e) => e.customerName === form.customerName)
})

const totals = computed(() => {
  let vao = 0
  let ra = 0
  for (const e of visibleEntries.value) {
    vao += toNumber(e.score)
    ra += toNumber(e.result)
  }
  return { vao, ra, chenhLech: vao - ra }
})

function formatNumber(n) {
  return new Intl.NumberFormat('vi-VN').format(n)
}

async function loadAll() {
  loading.value = true
  loadError.value = ''
  try {
    const [me, list] = await Promise.all([
      auth.fetchMe(),
      api.get('/me/entries'),
    ])
    entries.value = list.entries
  } catch (err) {
    loadError.value = err.message || 'Không tải được dữ liệu'
  } finally {
    loading.value = false
  }
}

onMounted(loadAll)
onMounted(loadBetTypes)
onMounted(loadCustomers)

async function submitForm() {
  formError.value = ''
  // Flatten every (type, row) pair that actually has a number typed in -
  // each one becomes its own data_entries row, so two numbers with
  // different stakes under the same type are never merged together.
  const tasks = []
  for (const t of betTypes.value) {
    for (const row of typeInputs[t]?.rows || []) {
      if (row.value.trim()) tasks.push({ type: t, row })
    }
  }
  if (!form.customerName.trim() || tasks.length === 0) {
    formError.value = 'Vui lòng nhập tên khách hàng và ít nhất một số (ở Đề/Lô/...)'
    return
  }
  submitting.value = true
  try {
    const results = await Promise.allSettled(
      tasks.map((task) =>
        api.post('/me/entries', {
          customerName: form.customerName.trim(),
          value: task.row.value.trim(),
          entryDate: form.entryDate,
          score: task.row.score.trim() || undefined,
          betType: task.type,
          note: form.note.trim() || undefined,
        })
      )
    )
    const failed = []
    let anySucceeded = false
    for (let i = 0; i < results.length; i++) {
      const r = results[i]
      const task = tasks[i]
      if (r.status === 'fulfilled') {
        entries.value.unshift(r.value)
        if (auth.user?.stats) auth.user.stats.used += 1
        anySucceeded = true
        const rows = typeInputs[task.type].rows
        const idx = rows.indexOf(task.row)
        if (idx !== -1) rows.splice(idx, 1)
      } else {
        failed.push(`${betTypeLabel(task.type)} "${task.row.value}": ${r.reason?.message || 'lỗi không rõ'}`)
      }
    }
    // Every type block always shows at least one (possibly blank) row.
    for (const t of betTypes.value) {
      if (typeInputs[t].rows.length === 0) typeInputs[t].rows.push(blankRow())
    }
    if (failed.length) formError.value = failed.join(' · ')
    if (anySucceeded) form.note = ''
    // Keep customerName + date - common to add several customers/entries
    // for the same day in a row.
  } finally {
    submitting.value = false
  }
}

// While editing, the customer being edited might have a customerName that
// isn't (or is no longer) in the roster - e.g. entered before the roster
// existed, or since removed from Khách hàng. Add it as an extra option so
// the <select> still shows and keeps it selected instead of silently
// blanking/changing the customer on save.
const editCustomers = computed(() => {
  const name = editForm.customerName
  if (!name || customers.value.some((c) => c.name === name)) return customers.value
  return [...customers.value, { id: `__current-${name}`, name }]
})

function startEdit(entry) {
  editingId.value = entry.id
  editError.value = ''
  editForm.customerName = entry.customerName || ''
  editForm.value = entry.value || ''
  editForm.entryDate = entry.entryDate || today()
  editForm.score = entry.score || ''
  editForm.betType = entry.betType || 'de'
  editForm.note = entry.note || ''
}

function cancelEdit() {
  editingId.value = null
  editError.value = ''
}

async function saveEdit(id) {
  editError.value = ''
  if (!editForm.customerName.trim() || !editForm.value.trim()) {
    editError.value = 'Vui lòng nhập tên khách hàng và số liệu'
    return
  }
  editSubmitting.value = true
  try {
    const updated = await api.patch(`/me/entries/${id}`, {
      customerName: editForm.customerName.trim(),
      value: editForm.value.trim(),
      entryDate: editForm.entryDate,
      score: editForm.score.trim(),
      betType: editForm.betType,
      note: editForm.note.trim(),
    })
    const idx = entries.value.findIndex((e) => e.id === id)
    if (idx !== -1) entries.value[idx] = updated
    editingId.value = null
  } catch (err) {
    editError.value = err.message || 'Không lưu được thay đổi'
  } finally {
    editSubmitting.value = false
  }
}

const deletingId = ref(null)
const deleteErrors = reactive({}) // id -> error message

async function deleteEntry(entry) {
  if (!(await showConfirm({
    title: 'Xoá số liệu',
    message: `Xoá số liệu "${entry.value}" (${entry.customerName})? Không thể hoàn tác.`,
    confirmText: 'Xoá',
    danger: true,
  }))) return
  deleteErrors[entry.id] = ''
  deletingId.value = entry.id
  try {
    await api.del(`/me/entries/${entry.id}`)
    entries.value = entries.value.filter((e) => e.id !== entry.id)
    if (auth.user?.stats) auth.user.stats.used = Math.max(auth.user.stats.used - 1, 0)
    if (editingId.value === entry.id) editingId.value = null
  } catch (err) {
    deleteErrors[entry.id] = err.message || 'Không xoá được'
  } finally {
    deletingId.value = null
  }
}
</script>

<template>
  <div class="page">
    <h1 class="page-title">Nhập số</h1>
    <p class="page-subtitle">Nhập tên khách hàng và số liệu. Nhập điểm ra (kết quả) ở trang Nhập kết quả.</p>

    <div v-if="stats" class="card quota-card">
      <div>
        <div class="quota-label">Gói: {{ pkg?.label }}</div>
        <div class="quota-numbers">
          <template v-if="stats.total >= 999999999">Không giới hạn số lượng nhập</template>
          <template v-else>Đã dùng {{ stats.used }} / {{ stats.total }}</template>
        </div>
      </div>
      <span class="chip" :class="pkg?.isActive ? 'chip-accent' : 'chip-danger'">
        {{ pkg?.isActive ? 'Đang hoạt động' : 'Hết hạn' }}
      </span>
    </div>

    <div v-if="!canAdd && stats" class="alert alert-warning">
      Gói của bạn đã hết hạn. Vui lòng gia hạn ở mục Gói dịch vụ để tiếp tục nhập số liệu.
    </div>

    <form class="card add-form" @submit.prevent="submitForm">
      <h3 style="margin-top: 0">Thêm số liệu mới</h3>
      <div v-if="formError" class="alert alert-error">{{ formError }}</div>

      <div class="ocr-box">
        <input
          ref="ocrFileInput"
          type="file"
          accept="image/*"
          capture="environment"
          style="display: none"
          @change="onImageSelected"
        />
        <button type="button" class="btn btn-secondary btn-block" :disabled="ocrRunning" @click="pickImage">
          <AppIcon v-if="!ocrRunning" name="camera" />
          {{ ocrRunning ? `Đang đọc ảnh... ${ocrProgress}%` : 'Nhập từ ảnh (đọc tự động)' }}
        </button>
        <p class="ocr-hint">Ảnh xử lý ngay trên trình duyệt, không gửi lên đâu cả. Kết quả chỉ là gợi ý. Hãy kiểm tra lại trước khi lưu.</p>

        <div v-if="ocrError" class="alert alert-error" style="margin-top: 8px">{{ ocrError }}</div>

        <div v-if="ocrPreviewUrl && !ocrRunning" class="ocr-result">
          <img :src="ocrPreviewUrl" alt="Ảnh đã chọn" class="ocr-thumb" />
          <div class="ocr-text-wrap">
            <label>Văn bản đọc được (để đối chiếu)</label>
            <textarea v-model="ocrRawText" rows="3" class="ocr-raw"></textarea>
            <button type="button" class="btn btn-ghost btn-sm" @click="clearOcr">Xoá gợi ý</button>
          </div>
        </div>
      </div>

      <div class="grid-2">
        <div class="field">
          <label for="customerName">Tên khách hàng *</label>
          <div class="input-wrap">
            <AppSelect id="customerName" v-model="form.customerName" required>
              <option value="">-- Chọn khách hàng --</option>
              <option v-for="c in customers" :key="c.id" :value="c.name">{{ c.name }}</option>
            </AppSelect>
          </div>
          <p v-if="customers.length === 0" class="hint">
            Chưa có khách hàng nào.
            <RouterLink :to="{ name: 'customers' }">+ Thêm khách hàng mới</RouterLink>
            trước khi nhập số liệu.
          </p>
          <p v-else class="hint">
            <RouterLink :to="{ name: 'customers' }">+ Thêm khách hàng mới</RouterLink>
          </p>
        </div>
        <div class="field">
          <label for="entryDate">Ngày</label>
          <div class="input-wrap">
            <AppDatePicker id="entryDate" v-model="form.entryDate" />
          </div>
        </div>
      </div>

      <p class="page-subtitle" style="margin: 0 0 8px">
        Mỗi số một dòng, điểm vào riêng cho từng số. Điền loại nào thì loại đó được lưu.
      </p>
      <div class="type-grid">
      <div v-for="t in betTypes" :key="t" class="type-row">
        <div class="type-row-label">{{ betTypeLabel(t) }}</div>
        <div class="rows-wrap">
          <div v-for="(row, i) in typeInputs[t].rows" :key="i" class="row-line">
            <div class="input-wrap row-number">
              <input v-model="row.value" type="text" placeholder="Số, vd: 12" />
            </div>
            <div class="input-wrap row-score">
              <input v-model="row.score" type="text" inputmode="decimal" placeholder="Điểm vào" />
            </div>
            <button
              type="button"
              class="btn btn-ghost btn-sm row-remove"
              :disabled="typeInputs[t].rows.length === 1 && !row.value && !row.score"
              @click="removeRow(t, i)"
            >
              <AppIcon name="x" />
            </button>
          </div>
          <button type="button" class="btn btn-ghost btn-sm" @click="addRow(t)">+ Thêm số {{ betTypeLabel(t) }}</button>
        </div>
      </div>
      </div>

      <div class="field">
        <label for="note">Ghi chú</label>
        <div class="input-wrap">
          <textarea id="note" v-model="form.note" rows="2" placeholder="Tuỳ chọn"></textarea>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block" :disabled="submitting || !canAdd">
        {{ submitting ? 'Đang thêm...' : 'Thêm số liệu' }}
      </button>
    </form>

    <h3>Danh sách số liệu {{ form.customerName ? `: ${form.customerName}` : '' }}</h3>
    <div v-if="loading" class="card">Đang tải...</div>
    <div v-else-if="loadError" class="alert alert-error">{{ loadError }}</div>
    <div v-else-if="!form.customerName" class="card">Chọn khách hàng ở trên để xem số liệu đã nhập của họ.</div>
    <div v-else-if="visibleEntries.length === 0" class="card">Khách hàng này chưa có số liệu nào.</div>
    <div v-else class="entry-list">
      <div v-for="entry in visibleEntries" :key="entry.id" class="card entry-card">
        <template v-if="editingId === entry.id">
          <div v-if="editError" class="alert alert-error">{{ editError }}</div>
          <div class="grid-2">
            <div class="field">
              <label>Tên khách hàng</label>
              <div class="input-wrap">
                <AppSelect v-model="editForm.customerName">
                  <option value="">-- Chọn khách hàng --</option>
                  <option v-for="c in editCustomers" :key="c.id" :value="c.name">{{ c.name }}</option>
                </AppSelect>
              </div>
            </div>
            <div class="field">
              <label>Ngày</label>
              <div class="input-wrap"><AppDatePicker v-model="editForm.entryDate" /></div>
            </div>
          </div>
          <div class="field">
            <label>Số liệu</label>
            <div class="input-wrap"><input v-model="editForm.value" type="text" /></div>
          </div>
          <div class="grid-2">
            <div class="field">
              <label>Loại đánh</label>
              <div class="input-wrap">
                <AppSelect v-model="editForm.betType">
                  <option v-for="t in betTypes" :key="t" :value="t">{{ betTypeLabel(t) }}</option>
                </AppSelect>
              </div>
            </div>
            <div class="field">
              <label>Điểm vào</label>
              <div class="input-wrap"><input v-model="editForm.score" type="text" inputmode="decimal" /></div>
            </div>
          </div>
          <p v-if="entry.result" class="page-subtitle" style="margin: -4px 0 8px">
            Điểm ra: {{ entry.result }} (sửa ở trang Nhập kết quả)
          </p>
          <div class="field">
            <label>Ghi chú</label>
            <div class="input-wrap"><textarea v-model="editForm.note" rows="2"></textarea></div>
          </div>
          <div class="entry-actions">
            <button class="btn btn-secondary btn-sm" @click="cancelEdit" :disabled="editSubmitting">Huỷ</button>
            <button class="btn btn-primary btn-sm" @click="saveEdit(entry.id)" :disabled="editSubmitting">
              {{ editSubmitting ? 'Đang lưu...' : 'Lưu' }}
            </button>
          </div>
        </template>
        <template v-else>
          <div class="entry-top">
            <strong>{{ entry.customerName }}</strong>
            <span class="chip">{{ betTypeLabel(entry.betType || 'de') }}</span>
            <span class="chip">{{ entry.entryDate }}</span>
          </div>
          <div class="entry-value">{{ entry.value }}</div>
          <div v-if="entry.score || entry.result" class="entry-meta">
            <span v-if="entry.score">Điểm vào: {{ entry.score }}</span>
            <span v-if="entry.result">Điểm ra: {{ entry.result }}</span>
          </div>
          <div v-if="entry.note" class="entry-note">{{ entry.note }}</div>
          <div v-if="deleteErrors[entry.id]" class="alert alert-error">{{ deleteErrors[entry.id] }}</div>
          <div class="entry-actions">
            <button
              class="btn btn-danger btn-sm"
              :disabled="deletingId === entry.id"
              @click="deleteEntry(entry)"
            >
              {{ deletingId === entry.id ? 'Đang xoá...' : 'Xoá' }}
            </button>
            <button class="btn btn-secondary btn-sm" @click="startEdit(entry)">Sửa</button>
          </div>
        </template>
      </div>
    </div>

    <template v-if="!loading && !loadError && form.customerName">
      <h3>Thống kê: {{ form.customerName }}</h3>
      <p class="page-subtitle" style="margin-top: -8px">
        Tính trên {{ visibleEntries.length }} số liệu của khách hàng đang chọn (điểm vào/ra để trống được tính là 0).
      </p>
      <div class="calc-grid">
        <div class="card calc-card">
          <div class="calc-label">Tổng điểm vào</div>
          <div class="calc-value calc-in">{{ formatNumber(totals.vao) }}</div>
        </div>
